# Copy this file to .env.local (local) and paste the same names into your hosting dashboard (Vercel/Netlify).
# Where to find each value: Supabase dashboard > Project Settings > API (see docs/SETUP.md).

# Public: safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" (legacy) or "publishable" key. Safe for the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: the "service_role" (legacy) or "secret" key. Server-side only. NEVER prefix with NEXT_PUBLIC_,
# never paste into chat/email, never commit. It bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by `npm run seed` (demo users). Ignored in the app itself.
SEED_DEMO_PASSWORD=

# Optional, for a SEPARATE demo project only. Never point these at your real database.
DEMO_SUPABASE_URL=
DEMO_SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=
