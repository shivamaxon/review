{
  "name": "branch-review-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "export:csv": "node scripts/export-csv.mjs",
    "seed:users": "tsx --env-file=.env.local scripts/seed-users.ts",
    "load:history": "tsx --env-file=.env.local scripts/load-history.ts",
    "verify:history": "tsx --env-file=.env.local scripts/verify-history.ts",
    "test:history": "tsx --test scripts/history.test.ts",
    "test:ui": "playwright test",
    "test:associate": "node --import tsx --test scripts/associate.test.ts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "test:review": "node --import tsx --test scripts/review-artifacts.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
